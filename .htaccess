# ==============================================================================
# SISFOR Anggaran - Apache Configuration for InfinityFree
# ==============================================================================

DirectoryIndex index.php index.html

# 1. Routing URL & Pengalihan Admin
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Akses langsung /admin atau /admin/ diarahkan ke admin.php
    RewriteRule ^admin/?$ admin.php [L,QSA]

    # Pengalihan internal admin.html ke admin.php
    RewriteRule ^admin\.html$ admin.php [L,QSA]
</IfModule>

# 2. Proteksi File Konfigurasi Sensitif
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
