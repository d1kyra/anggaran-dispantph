# ==============================================================================
# SISFOR Anggaran - Apache Security & Hardening Configuration (.htaccess)
# ==============================================================================

DirectoryIndex index.php index.html

# 1. Matikan Directory Browsing (Mencegah bot/hacker melihat daftar file folder)
Options -Indexes

# 2. Blokir akses ke file sensitif (.env, .git, sql, config, markdown, log)
<FilesMatch "^(\.env|\.env\..*|\.git.*|.*\.sql|.*\.jsonl?|composer\..*|.*\.log|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Blokir akses ke file .htaccess itu sendiri
<Files ".htaccess">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# 4. Blokir akses HTTP langsung ke file internal & middleware sensitif
<FilesMatch "^(auth_middleware|security|setup_database)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 5. Security Headers
<IfModule mod_headers.c>
    # Mencegah clickjacking / embedding di iframe situs judi / pihak ketiga
    Header always set X-Frame-Options "SAMEORIGIN"
    # Mencegah MIME-type sniffing (mencegah file gambar dieksekusi sebagai script)
    Header always set X-Content-Type-Options "nosniff"
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Mod_Rewrite Rules: Routing, Blokir Scanner Backdoor, Injeksi, & Direktori Internal
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Akses langsung /admin atau /admin/ diarahkan ke admin.php
    RewriteRule ^admin/?$ admin.php [L,QSA]

    # Pengalihan internal admin.html ke admin.php
    RewriteRule ^admin\.html$ admin.php [L,QSA]

    # Blokir direktori internal (db, logs)
    RewriteRule (^|/)(db|logs)(/|$) - [F,L,NC]

    # A. Blokir metode HTTP berisiko (TRACE & TRACK)
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
    RewriteRule .* - [F,L]

    # B. Blokir query string berbahaya (Injeksi Script, Webshell, LFI/RFI)
    RewriteCond %{QUERY_STRING} (eval\(|base64_decode|system\(|passthru\(|shell_exec\(|proc_open) [NC,OR]
    RewriteCond %{QUERY_STRING} (<script.*>|%3Cscript.*%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (union.*select|insert.*into|drop.*table|benchmark\(|sleep\() [NC,OR]
    RewriteCond %{QUERY_STRING} (php:\/\/|data:\/\/|glob:\/\/|file:\/\/) [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\.\/|\.\.\\) [NC]
    RewriteRule .* - [F,L]
</IfModule>
