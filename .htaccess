# ==============================================================================
# SISFOR Anggaran - Apache Security Configuration (.htaccess)
# ==============================================================================

# 1. Matikan Directory Browsing (Mencegah pengunjung melihat daftar file folder)
Options -Indexes

# 2. Blokir akses langsung ke file sensitif & konfigurasi server
<FilesMatch "^(\.env|\.env\..*|\.git.*|.*\.sql|.*\.jsonl?|composer\..*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Blokir akses HTTP langsung ke file internal middleware
<FilesMatch "^(auth_middleware)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Security Headers
<IfModule mod_headers.c>
    # Mencegah clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # Mencegah MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Pengalihan internal admin.html ke admin.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^admin\.html$ admin.php [L]
</IfModule>
