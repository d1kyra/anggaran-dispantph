# SISFOR Anggaran - Environment Configuration Template
# Salin file ini menjadi .env lalu sesuaikan nilainya dengan konfigurasi server Anda
# JANGAN cantumkan password asli di dalam file .example ini!

DB_HOST=localhost
DB_NAME=sisfor_anggaran
DB_USER=root
DB_PASS=your_db_password_here

ADMIN_USER=admin
ADMIN_PASS=masukkan_password_aslinya
